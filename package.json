{
  "name": "not-me",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:e2e": "VITE_E2E=true npm run build",
    "preview": "vite preview",
    "test": "vitest run --exclude 'e2e/**'",
    "test:watch": "vitest --exclude 'e2e/**'",
    "test:e2e": "playwright test",
    "test:production": "NOTME_PRODUCTION_CHECK=true playwright test e2e/marble.spec.ts --grep '빌드 설정'",
    "typecheck": "tsc -b",
    "lint": "tsc -b --pretty false",
    "verify": "npm run lint && npm test && npm run build && npm run test:production && npm run build:e2e && npm run test:e2e -- --workers=1"
  },
  "dependencies": {
    "box2d-wasm": "^7.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  }
}
